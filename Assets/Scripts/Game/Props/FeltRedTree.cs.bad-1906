using System.Collections.Generic;
using UnityEngine;

/// One pompom bouquet on a ribbed yarn trunk. DriveLook/grok/detail-trees-closer.png.
/// Three flowers share one mass: orange petals on top, red petals around and below, tan centers
/// on the camera face. Each petal is buried in its neighbours, so no gap shows through.
public static class FeltRedTree
{
    const int Red = 0, Orange = 1, Tan = 2;
    const float TrunkHeight = 0.70f;

    static Material _trunk, _red, _redDeep, _orange, _tan;
    static Mesh _ribs;

    /// Root is named "Red Tree". Position is world space. Scale 1 is about 1.55 tall, foot on y = 0.
    public static GameObject Build(Vector3 position, float scale = 1f)
    {
        var root = new GameObject("Red Tree");
        root.transform.position = position;
        root.transform.localScale = Vector3.one * Mathf.Max(0.01f, scale);
        root.isStatic = true;

        Transform host = root.transform;
        var trunk = new GameObject("Red Trunk");
        trunk.transform.SetParent(host, false);
        trunk.isStatic = true;
        trunk.AddComponent<MeshFilter>().sharedMesh = RibbedTrunk();
        var trunkRenderer = trunk.AddComponent<MeshRenderer>();
        if (TrunkYarn() != null) trunkRenderer.sharedMaterial = TrunkYarn();

        Bloom(host);
        return root;
    }

    /// One packed bouquet sitting on the trunk. Orange on top, red around it, tan centers on the camera face.
    static void Bloom(Transform host)
    {
        Vector3 c = new Vector3(0.00f, 0.96f, -0.05f);
        const int count = 34;
        for (int i = 0; i < count; i++)
        {
            float y01 = (i + 0.5f) / count;
            float ang = i * 2.39996323f;
            float ring = Mathf.Sqrt(Mathf.Max(0f, 1f - Mathf.Pow(2f * y01 - 1f, 2f)));
            Vector3 p = c + new Vector3(
                Mathf.Cos(ang) * ring * 0.28f,
                (y01 - 0.42f) * 0.64f,
                Mathf.Sin(ang) * ring * 0.24f);
            int kind = y01 > 0.60f ? Orange : Red;
            bool face = p.z < c.z - 0.05f && y01 > 0.30f && y01 < 0.74f;
            if (face && i % 8 == 2) kind = Tan;
            float radius = kind == Tan ? 0.060f : 0.112f + 0.018f * ((i * 3) % 5) / 4f;
            Pom(host, kind, p, radius, i + 1);
        }
        Pom(host, Orange, c + new Vector3(0.00f, 0.18f, -0.04f), 0.125f, 2);
        Pom(host, Tan, c + new Vector3(-0.06f, 0.04f, -0.16f), 0.058f, 4);
        Pom(host, Tan, c + new Vector3(0.07f, -0.02f, -0.15f), 0.055f, 6);
    }

    /// Petals sit on a ring smaller than their diameter, so they squash into one flower.
    static void Petals(Transform host, int kind, Vector3 center, float radius, int count, float ring, int seed)
    {
        for (int i = 0; i < count; i++)
        {
            float a = (i + 0.15f) * Mathf.PI * 2f / count;
            var p = center + new Vector3(Mathf.Cos(a) * ring, Mathf.Sin(a) * ring, Mathf.Sin(a * 2f) * 0.015f);
            Pom(host, kind, p, radius, seed + i);
        }
    }

    static void Pom(Transform host, int kind, Vector3 localPos, float radius, int index)
    {
        string name = kind == Orange ? "Orange Pompom" : kind == Tan ? "Tan Pompom" : "Red Pompom";
        Material mat = kind == Orange ? OrangeWool() : kind == Tan ? TanWool() : ((index & 1) == 0 ? RedWool() : RedDeep());
        var go = new GameObject(name);
        go.transform.SetParent(host, false);
        go.transform.localPosition = localPos;
        int seed = 4 + (Mathf.Abs(index) % 7);
        go.transform.localRotation = Quaternion.Euler(seed * 19f, index * 47f, seed * 11f);
        go.isStatic = true;
        go.AddComponent<MeshFilter>().sharedMesh = CraftMesh.Pompom(radius, 0.16f, 14, 10, seed);
        var renderer = go.AddComponent<MeshRenderer>();
        if (mat != null) renderer.sharedMaterial = mat;
    }

    static float RibRadius(float u, float phi)
    {
        const int cords = 12;
        const float amp = 0.30f;
        float radius = Mathf.Lerp(0.22f, 0.16f, u);
        radius *= 1f + 0.045f * Mathf.Sin(u * Mathf.PI);
        float body = Mathf.Clamp01(u / 0.05f);
        return radius * (1f + amp * Mathf.Cos(phi * cords) * body);
    }

    static Vector3 RibPoint(float u, float phi)
    {
        float r = RibRadius(u, phi);
        return new Vector3(Mathf.Cos(phi) * r, TrunkHeight * u, Mathf.Sin(phi) * r);
    }

    /// Deep vertical cords. Normals follow the grooves, so the column does not shade as a smooth stick.
    static Mesh RibbedTrunk()
    {
        if (_ribs != null) return _ribs;
        const int around = 84;
        const int rows = 18;
        int cols = around + 1;
        var v = new List<Vector3>(rows * cols + 2);
        var nrm = new List<Vector3>(rows * cols + 2);
        var uv = new List<Vector2>(rows * cols + 2);
        var tris = new List<int>((rows - 1) * around * 6);

        for (int row = 0; row < rows; row++)
        {
            float u = row / (float)(rows - 1);
            for (int iu = 0; iu <= around; iu++)
            {
                float phi = iu / (float)around * Mathf.PI * 2f;
                Vector3 p = RibPoint(u, phi);
                Vector3 dp = RibPoint(u, phi + 0.01f) - p;
                Vector3 du = RibPoint(Mathf.Min(1f, u + 0.01f), phi) - p;
                Vector3 normal = Vector3.Cross(dp, du);
                if (normal.sqrMagnitude < 1e-8f) normal = new Vector3(p.x, 0f, p.z);
                v.Add(p);
                nrm.Add(normal.normalized);
                uv.Add(new Vector2(iu / (float)around * 3.5f, u * 2.2f));
            }
        }
        for (int row = 0; row < rows; row++)
        {
            int a = row * cols;
            int b = a + cols - 1;
            Vector3 avg = (nrm[a] + nrm[b]).normalized;
            nrm[a] = avg;
            nrm[b] = avg;
        }
        for (int row = 0; row < rows - 1; row++)
        {
            int rowA = row * cols;
            int rowB = rowA + cols;
            for (int iu = 0; iu < around; iu++)
            {
                int i0 = rowA + iu, i1 = i0 + 1, i2 = rowB + iu, i3 = i2 + 1;
                tris.Add(i0); tris.Add(i2); tris.Add(i1);
                tris.Add(i1); tris.Add(i2); tris.Add(i3);
            }
        }

        int bottom = v.Count;
        v.Add(Vector3.zero);
        nrm.Add(Vector3.down);
        uv.Add(new Vector2(0.5f, 0f));
        int top = v.Count;
        v.Add(new Vector3(0f, TrunkHeight, 0f));
        nrm.Add(Vector3.up);
        uv.Add(new Vector2(0.5f, 2.2f));
        Fan(v, tris, bottom, 0, around, Vector3.down);
        Fan(v, tris, top, (rows - 1) * cols, around, Vector3.up);

        _ribs = new Mesh { name = "Red Trunk Ribs" };
        _ribs.SetVertices(v);
        _ribs.SetNormals(nrm);
        _ribs.SetUVs(0, uv);
        _ribs.SetTriangles(tris, 0);
        _ribs.RecalculateBounds();
        _ribs.RecalculateTangents();
        return _ribs;
    }

    static void Fan(List<Vector3> v, List<int> tris, int center, int ring, int seg, Vector3 outward)
    {
        Vector3 n = Vector3.Cross(v[ring] - v[center], v[ring + 1] - v[center]);
        bool wind = Vector3.Dot(n, outward) >= 0f;
        for (int i = 0; i < seg; i++)
        {
            int a = ring + i, b = a + 1;
            if (wind) { tris.Add(center); tris.Add(a); tris.Add(b); }
            else { tris.Add(center); tris.Add(b); tris.Add(a); }
        }
    }

    static Material TrunkYarn()
    {
        if (_trunk != null) return _trunk;
        _trunk = Felt("Red Trunk Yarn", "Look/tex-yarn-fiber", new Color(1.00f, 0.97f, 0.90f), new Color(0.58f, 0.45f, 0.32f),
            Vector2.one, 2.4f, 0.18f, 0.68f, 0.03f, 0.20f);
        return _trunk;
    }

    static Material RedWool()
    {
        if (_red != null) return _red;
        _red = Felt("Red Bloom", "Look/tex-felt-red", new Color(1.00f, 0.92f, 0.90f), new Color(0.62f, 0.16f, 0.16f),
            new Vector2(1.7f, 1.7f), 2.6f, 0.20f, 0.80f, 0.03f, 0.16f);
        return _red;
    }

    static Material RedDeep()
    {
        if (_redDeep != null) return _redDeep;
        _redDeep = Felt("Red Bloom Deep", "Look/tex-felt-red", new Color(0.78f, 0.70f, 0.72f), new Color(0.46f, 0.11f, 0.12f),
            new Vector2(1.7f, 1.7f), 2.6f, 0.18f, 0.80f, 0.03f, 0.16f);
        return _redDeep;
    }

    /// tex-felt-red mean is about (116, 20, 26). These multipliers land near (189, 92, 37).
    static Material OrangeWool()
    {
        if (_orange != null) return _orange;
        _orange = Felt("Orange Bloom", "Look/tex-felt-red", new Color(1.62f, 4.70f, 1.42f), new Color(0.74f, 0.36f, 0.15f),
            new Vector2(1.7f, 1.7f), 2.6f, 0.22f, 0.80f, 0.04f, 0.14f);
        return _orange;
    }

    static Material TanWool()
    {
        if (_tan != null) return _tan;
        _tan = Felt("Tan Bloom", "Look/tex-felt-brown", new Color(1.34f, 1.53f, 1.51f), new Color(0.73f, 0.57f, 0.38f),
            new Vector2(1.6f, 1.6f), 2.4f, 0.18f, 0.78f, 0.03f, 0.14f);
        return _tan;
    }

    /// Escape/FeltFiber when the shader and the Look plate both load. Otherwise a flat fallback color.
    static Material Felt(string matName, string resource, Color tint, Color fallback, Vector2 tile, float bump, float sheen, float wrap, float smooth, float fiber)
    {
        var shader = Shader.Find("Escape/FeltFiber");
        var tex = Resources.Load<Texture2D>(resource);
        if (shader == null || tex == null)
        {
            shader = Shader.Find("Universal Render Pipeline/Lit");
            if (shader == null) shader = Shader.Find("Standard");
            if (shader == null) return null;
            var plain = new Material(shader) { name = matName };
            plain.enableInstancing = true;
            if (plain.HasProperty("_BaseColor")) plain.SetColor("_BaseColor", fallback);
            if (plain.HasProperty("_Color")) plain.color = fallback;
            if (plain.HasProperty("_Smoothness")) plain.SetFloat("_Smoothness", 0.08f);
            if (plain.HasProperty("_Glossiness")) plain.SetFloat("_Glossiness", 0.08f);
            return plain;
        }

        var mat = new Material(shader) { name = matName };
        mat.enableInstancing = true;
        if (mat.HasProperty("_BaseMap"))
        {
            mat.SetTexture("_BaseMap", tex);
            mat.SetTextureScale("_BaseMap", tile);
        }
        if (mat.HasProperty("_MainTex"))
        {
            mat.SetTexture("_MainTex", tex);
            mat.SetTextureScale("_MainTex", tile);
        }
        var fuzz = Resources.Load<Texture2D>("Look/tex-felt-normal");
        if (fuzz != null && mat.HasProperty("_BumpMap"))
        {
            mat.SetTexture("_BumpMap", fuzz);
            mat.SetTextureScale("_BumpMap", tile);
        }
        if (mat.HasProperty("_BaseColor")) mat.SetColor("_BaseColor", tint);
        if (mat.HasProperty("_Color")) mat.color = tint;
        if (mat.HasProperty("_BumpScale")) mat.SetFloat("_BumpScale", bump);
        if (mat.HasProperty("_Sheen")) mat.SetFloat("_Sheen", sheen);
        if (mat.HasProperty("_Wrap")) mat.SetFloat("_Wrap", wrap);
        if (mat.HasProperty("_Smoothness")) mat.SetFloat("_Smoothness", smooth);
        if (mat.HasProperty("_FiberAmt")) mat.SetFloat("_FiberAmt", fiber);
        if (mat.HasProperty("_SeamAmt")) mat.SetFloat("_SeamAmt", 0f);
        return mat;
    }
}
