{
  "name": "espresso-escape",
  "version": "1.0.5",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ios:direct": "bash ../../.github/scripts/ios-apple-direct.sh",
    "preflight:ios": "bash ./scripts/preflight-ios.sh",
    "bump:ios": "node ./scripts/bump-ios-build.mjs",
    "check:game": "node ./scripts/check-game.mjs",
    "playtest": "node ./scripts/playtest.mjs",
    "typecheck": "tsc --noEmit",
    "eas:build:ios": "npx --yes eas-cli@16.28.0 build --platform ios --profile production",
    "eas:build:android": "npx --yes eas-cli@16.28.0 build --platform android --profile production",
    "eas:build:all": "npx --yes eas-cli@16.28.0 build --platform all --profile production",
    "eas:build:internal": "npx --yes eas-cli@16.28.0 build --platform ios --profile internal",
    "eas:submit:ios": "npx --yes eas-cli@16.28.0 submit --platform ios --profile production --latest",
    "eas-build-pre-install": "node ./scripts/restore-assets.js"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
